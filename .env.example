# Use a dedicated application role and database in every environment.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trejder
# Integration tests intentionally require a separate disposable database.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trejder_test

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# One-time operational bootstrap. Remove the password after the first successful run.
TREJDER_ADMIN_EMAIL=admin@trejder.se
TREJDER_ADMIN_PASSWORD=replace-with-a-temporary-strong-password
TREJDER_ADMIN_COMPANY_NAME=PWT Invest AB
TREJDER_ADMIN_COMPANY_ORGANIZATION_NUMBER=559429-3390
TREJDER_ADMIN_COMPANY_CONTACT_EMAIL=admin@trejder.se

# Development uses an isolated console transport. Production sends through
# Resend after trejder.se has been verified as a sending domain.
RESEND_API_KEY=re_replace-me
TRANSACTIONAL_EMAIL_FROM=Trejder <konto@trejder.se>

# Private vehicle images. Development defaults to .data/vehicle-images.
LOCAL_IMAGE_STORAGE_ROOT=.data/vehicle-images
# Production uses a private Cloudflare R2 (S3-compatible) bucket.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET=trejder-private-images

# Server-side license-plate detection. Images are normalized locally, sent to
# Plate Recognizer Snapshot Cloud, and blurred locally before publication.
PLATE_RECOGNIZER_API_TOKEN=replace-me
PLATE_RECOGNIZER_API_URL=https://api.platerecognizer.com/v1/plate-reader/
PLATE_RECOGNIZER_CONFIDENCE=0.75
PLATE_RECOGNIZER_TIMEOUT_MS=12000

# The first commercial terms version. Values are server-owned integer ore.
COMMERCIAL_TERMS_VERSION=dealer-v1
