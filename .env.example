# Use a dedicated application role and database in every environment.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trejder
# Integration tests intentionally require a separate disposable database.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trejder_test

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Development uses an isolated console email transport. Production must install
# an EmailTransport adapter; token-bearing URLs must never be logged there.

# Private vehicle images. Development defaults to .data/vehicle-images.
LOCAL_IMAGE_STORAGE_ROOT=.data/vehicle-images
# Production uses a private Cloudflare R2 (S3-compatible) bucket.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET=trejder-private-images

# The first commercial terms version. Values are server-owned integer ore.
COMMERCIAL_TERMS_VERSION=dealer-v1
